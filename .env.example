# Local development only. Copy to `.env.local` and edit.
#
#   cp .env.example .env.local
#
# `.env*` is gitignored (this example file is the one exception). Never commit
# `.env.local`, and never put a real customer or staff email address here.
#
# These variables are read ONLY by the development auth shim
# (`app/dev-auth.ts`), which refuses to load in a production build. They have no
# effect on ChatGPT Sites, where the platform injects the authenticated user.

# Signs you in locally as this user. Leave unset or blank to browse signed out.
VITE_DEV_AUTH_EMAIL=dev@example.com

# Optional display name. Falls back to the email address when unset.
VITE_DEV_AUTH_FULL_NAME=Dev User
